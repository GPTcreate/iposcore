# 애드센스 소유권 확인용 ID. 아래 광고 활성화 옵션과는 별개입니다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# 실제 광고 게재 준비 후에만 true. 검증 대기/관리 페이지에는 로더를 넣지 않습니다.
NEXT_PUBLIC_ADSENSE_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# 관리자와 크론 인증. 서버 설정에서 별도로 안전한 값을 지정하세요. 기본 비밀번호는 없습니다.
ADMIN_SECRET=
CRON_SECRET=
DART_API_KEY=

# [선택] Gemini 2.5 API 키 (유튜브 자막 및 블로그 텍스트 AI 감성 분석용)
GEMINI_API_KEY=your_gemini_api_key_here

# [선택] Resend 또는 이메일 발송 서비스 API 키
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# [선택/권장] Google Analytics 4 (GA4) 측정 ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# [필수 - 프로덕션 영속 저장소] 구독자 DB 동기화용 Google Sheet Apps Script 웹 앱 URL
# Vercel 등 서버리스 환경에서는 로컬 파일이 영구 보존되지 않으므로, 이 웹훅이 필수 영속 저장소로 동작합니다.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

